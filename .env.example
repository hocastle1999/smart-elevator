# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 올라가지 않습니다)
# DB 없이도 시뮬레이션, 화면, REST/WebSocket은 동작합니다. 운행 기록 저장과 통계 API만 DB가 필요합니다.
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_elevator
DB_USER=smart_elevator_app
# scripts/init_db.sql에 넣은 비밀번호와 같은 값
DB_PASSWORD=change-me

# 관리 API(고장 주입, 수리, 점검, 복귀) 토큰. 비워 두면 관리 API는 꺼진다(403).
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_TOKEN=
